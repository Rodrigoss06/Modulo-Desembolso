# Copiar como .env y ajustar. Nunca versionar el .env real.
AMBIENTE=desarrollo
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/bna
BUS_BASE_URL=http://127.0.0.1:9000
CORS_ORIGENES=http://localhost:3000

# Seguridad: emisor/audiencia del JWT y credenciales del token de servicio (solo desarrollo)
JWT_EMISOR=bna-seguridad
JWT_AUDIENCIA=bna-api
SERVICIO_CLIENTE_ID=desembolso-svc
SERVICIO_CLIENTE_SECRETO=desembolso-dev-secret

# Integracion (segundos)
TIMEOUT_DEPENDENCIA_SEG=3
TIMEOUT_ABONO_SEG=3
REINTENTOS_CONSULTA=2

# Recuperacion de ordenes inciertas
RECUPERACION_INTERVALO_SEG=10
RECUPERACION_ESPERA_SEG=30
RECUPERACION_GRACIA_SEG=120
ALERTA_INCIERTA_MIN=15

# Entrega a Cobranza (outbox)
ENTREGA_INTERVALO_SEG=5
ENTREGA_MAX_INTENTOS=10
ENTREGA_BACKOFF_BASE_SEG=5
ENTREGA_BACKOFF_MAX_SEG=900

# Reglas configurables (pendientes de ratificacion)
VALIDACION_VIGENCIA_MIN=30
ANTIFRAUDE_HABILITADO=true
REVERSION_HABILITADA=false
REVERSION_PLAZO_HORAS=24

TRABAJOS_HABILITADOS=true
